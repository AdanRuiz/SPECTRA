{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "art_05_resultados",
  "type": "object",
  "required": ["status_ejecucion", "hash_propuesta", "entorno", "resumen", "desviaciones"],
  "properties": {
    "modo": {"enum": ["implementacion_nueva", "implementacion_existente"]},
    "status_ejecucion": {"enum": ["SUCCESS", "PARTIAL", "FAILED"]},
    "hash_propuesta": {"type": ["string", "null"]},
    "entorno": {"type": "object"},
    "corridas": {"type": "array", "items": {"type": "object"}},
    "resumen": {"type": "object"},
    "baselines": {"type": "array", "items": {"type": "object"}},
    "pruebas_estadisticas": {"type": "array", "items": {"type": "object"}},
    "desviaciones": {"type": "array", "items": {"type": "object", "required": ["descripcion", "justificacion"]}},
    "tablas_latex": {"type": "array"},
    "rutas_graficos": {"type": "array"},
    "codigo": {"type": "object"},
    "log_experimento": {"type": "string"},
    "componentes_documentados": {"type": "array", "items": {"type": "object", "required": ["nombre", "descripcion"]}},
    "evidencia": {"type": "array", "items": {"type": "object", "required": ["afirmacion", "fuente"],
      "properties": {"afirmacion": {"type": "string"}, "fuente": {"type": "string"}, "tipo": {"type": "string"}, "valor": {}}}},
    "hipotesis_evaluadas": {"type": "array", "items": {"type": "object", "required": ["hipotesis", "estado"],
      "properties": {"hipotesis": {"type": "string"},
                     "estado": {"enum": ["confirmada", "parcialmente_confirmada", "no_confirmada", "no_evaluada"]},
                     "justificacion": {"type": "string"}}}},
    "mecanismos_evaluacion_sugeridos": {"type": "array", "items": {"type": "object", "required": ["nombre", "objetivo", "procedimiento", "prioridad"],
      "properties": {"nombre": {"type": "string"}, "objetivo": {"type": "string"}, "hipotesis": {"type": "string"},
                     "metricas": {}, "procedimiento": {"type": "string"}, "instrumentacion": {"type": "string"},
                     "criterio_exito": {"type": "string"}, "prioridad": {"enum": ["alta", "media", "baja"]}, "esfuerzo": {"type": "string"}}}},
    "ejecuciones": {"type": "array"},
    "limitaciones_evidencia": {"type": "array", "items": {"type": "string"}}
  }
}
